# ==============================================================================
# SII Next.js Cloudflare Backend - Environment Variables Example
# NOTA: Usar únicamente valores sintéticos o ficticios en este archivo.
# JAMÁS colocar credenciales reales ni claves privadas de producción.
# ==============================================================================

# Secreto de 32 bytes (64 caracteres hex o 32 caracteres ASCII) para cifrado AES-256-GCM de sesiones
# OBLIGATORIO en servidor: Si no está configurado, las rutas de autenticación responden HTTP 503.
SESSION_SECRET=

# Origen base del servidor SII upstream (fijo en https://sii.celaya.tecnm.mx)
SII_BASE_URL=https://sii.celaya.tecnm.mx

# Timeout para llamadas a SII en milisegundos (por defecto 8000)
SII_TIMEOUT_MS=8000

# Origen público canónico del frontend y backend (sin ruta)
APP_ORIGIN=

# Solo servidor: URI privada del pooler PostgreSQL. Nunca usar NEXT_PUBLIC_.
DATABASE_URL=
# Diagnóstico deshabilitado por defecto; token temporal y vencimiento Unix máximo30min.
DATABASE_CHECK_TOKEN=
DATABASE_CHECK_EXPIRES_AT=
