{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "examen3-sii",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "observability": {
    "enabled": false
  }
}
