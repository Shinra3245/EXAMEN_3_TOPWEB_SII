{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "examen3-sii",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "server-only": "./src/server/worker-only-shim.ts"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  // Límite de intentos de inicio de sesión (Cloudflare Rate Limiting, sin KV ni Durable Objects).
  "ratelimits": [
    {
      "name": "LOGIN_IP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "LOGIN_ACCOUNT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d6e22ef3afe34911b20c8789c56a04fb"
    }
  ]
}
