{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "examen3-sii",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "server-only": "./src/server/worker-only-shim.ts"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d6e22ef3afe34911b20c8789c56a04fb"
    }
  ]
}
